#!/usr/bin/env bash
#
# ide - VS Code-like tmux layout
#
# Layout:
# +──────────────+──────────────────────+
# │  File Tree   │                      │
# │  (eza)       │    Claude Code       │
# │              │                      │
# ├──────────────┤                      │
# │              ├──────────────────────┤
# │  Git Tree    │    Terminal          │
# │              │                      │
# +──────────────+──────────────────────+

set -eu

SESSION_NAME="${1:-ide}"
WORK_DIR="${2:-$(pwd)}"

# Create session or attach if exists
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  echo "Session '$SESSION_NAME' already exists. Attaching..."
  tmux attach-session -t "$SESSION_NAME"
  exit 0
fi

# Create new session (pane 1: left-top -> File Tree)
tmux new-session -d -s "$SESSION_NAME" -c "$WORK_DIR" -x "$(tput cols)" -y "$(tput lines)"

# Split right (pane 2: right-top -> Claude Code, 65% width)
tmux split-window -h -t "$SESSION_NAME":1.1 -c "$WORK_DIR" -l "65%"

# Split right pane bottom (pane 3: right-bottom -> Terminal)
tmux split-window -v -t "$SESSION_NAME":1.2 -c "$WORK_DIR" -l "40%"

# Split left pane bottom (pane 4: left-bottom -> Git Tree)
tmux split-window -v -t "$SESSION_NAME":1.1 -c "$WORK_DIR" -l "50%"

# Pane 1 (left-top): File Tree with auto-refresh
tmux send-keys -t "$SESSION_NAME":1.1 "watch -n 30 -c -- 'eza -T -L 3 -a -I \"node_modules|.git|.cache\" --icons --color=always 2>/dev/null || find . -maxdepth 3 | head -100'" Enter

# Pane 2 (left-bottom): Git Tree with auto-refresh
tmux send-keys -t "$SESSION_NAME":1.2 "watch -n 10 -c -- 'git log --oneline --graph --all --decorate --color=always -20 2>/dev/null || echo \"Not a git repository\"'" Enter

# Pane 3 (right-top): Claude Code
tmux send-keys -t "$SESSION_NAME":1.3 "claude" Enter

# Pane 4 (right-bottom): Terminal (clean shell)

# Focus on the terminal pane (right-bottom)
tmux select-pane -t "$SESSION_NAME":1.4

# Attach to session
tmux attach-session -t "$SESSION_NAME"
