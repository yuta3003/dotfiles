#################################################
#
#  Start-up Setting
#
{{ if eq .chezmoi.os "linux" -}}
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
  eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end -}}


#################################################
#
#  PATH setting
#

{{ if eq .chezmoi.os "linx" -}}
  export GTK_IM_MODULE=fcitx
  export QT_IM_MODULE=fcitx
  export XMODIFIERS=@im=fcitx
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
  #  Default
  export USR_LOCAL_HOME="/usr/local"
  # for openssl
  export OPENSSL="$(brew --prefix openssl)"
  # for pyenv
  export PYENV_ROOT="${HOME}/.anyenv/envs/pyenv"
  # for poetry
  export POETRY_ROOT="${HOME}/.poetry"
  # for asdf - node plugins
  export GAWK_ROOT="/opt/homebrew/opt/gawk"
  # for starship
  export STARSHIP_CONFIG="${HOME}/.config/starship/starship.toml"
  # /usr/bin/python3 -- system Python
  # $(brew --prefix) python -v -- Homebrew Python
  # ${HOME}/.anyenv/envs/pyenv/shims/python3 -- pyenv Python

  # for binutils
  export BINUTIL_ROOT="${HOMEBREW_PREFIX}/opt/binutils"

  path=(
    "$OPENSSL/bin"(N-/)
    "$USR_LOCAL_HOME/bin"(N-/)
    "$USR_LOCAL_HOME/sbin"(N-/)
    "$PYENV_ROOT/bin"(N-/)
    "$POETRY_ROOT/bin"(N-/)
    "$GAWK_ROOT/libexec/gnubin"(N-/)
    "$BINUTIL_ROOT/bin"(N-/)
    "$path[@]"
  )

  # pathの重複排除: ユニーク属性を追加
  typeset -U path cdpath fpath manpath
{{ end -}}



#################################################
#
#  ANYENV setting
#

if command -v anyenv 1>/dev/null 2>&1; then
  eval "$(anyenv init -)"
fi

# ---------------
# pyenv
# ---------------
if command -v pyenv 1>/dev/null 2>&1; then
  eval "$(pyenv init --path)"
  eval "$(pyenv init -)"
fi

#################################################
#
#  setting COLOR
#

if type vivid >/dev/null 2>&1; then
  # https://github.com/sharkdp/vivid
  export LS_COLORS="$(vivid generate jellybeans)"
fi

#################################################
#
#  Loading
#

#  .zshrcを読み込む
if [ -f "${ZDOTDIR}/.zshrc" ] ; then
  source "${ZDOTDIR}/.zshrc"
fi
#  .zaliasesを読み込み
if [ -f "${ZDOTDIR}/.zaliases" ] ; then
  source "${ZDOTDIR}/.zaliases"
fi

if [[ "$SHLVL" = 1 ]]; then
  tmux new-session -A -s local-session
fi
